# Copia este archivo como ".env" (o configura estas variables en tu
# sistema / en el panel de Render) y completa con los datos reales de
# tu proyecto en https://supabase.com

# --- Conexión a la base de datos (Supabase > Project Settings > Database) ---
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=tu_password_de_supabase

# --- Seguridad JWT ---
# Genera una clave larga y aleatoria, por ejemplo con: openssl rand -base64 48
JWT_SECRET=cambia_esta_clave_por_una_generada_aleatoriamente_de_al_menos_32_caracteres
JWT_EXPIRATION_MS=3600000

# --- CORS ---
CORS_ORIGINS=*

# --- Puerto (Render lo asigna automáticamente en producción) ---
PORT=8080
