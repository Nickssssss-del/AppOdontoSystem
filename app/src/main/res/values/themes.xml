<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OdontoSystem" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_medium</item>
        <item name="colorPrimaryVariant">@color/brand_navy</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/brand_deep</item>
        <item name="colorSecondaryVariant">@color/brand_bright</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="android:statusBarColor">@color/brand_midnight</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/brand_midnight</item>
    </style>

    <style name="Theme.OdontoSystem.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/brand_midnight</item>
    </style>
</resources>
